#!/usr/bin/env bash
# herdr-worktree
#
# Smart wrapper around `herdr worktree create`.
# Defaults to sibling checkouts next to the current repo while still creating a
# herdr workspace for the new worktree. If no branch is supplied, generate a
# branch name similar to herdr's built-in dialog: worktree/<adjective>-<noun>-<hex>.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: herdr-worktree [branch] [--base REF] [--path PATH] [--repo PATH] [--interactive] [--no-fetch] [--dry-run]

Examples:
  herdr-worktree
  herdr-worktree --interactive
  herdr-worktree feature/my-change
  herdr-worktree origin/feature/my-change
  herdr-worktree --base origin/main
  herdr-worktree --no-fetch feature/my-change
  herdr-worktree feature/my-change --path ../ivit-monorepo-my-change

The checkout dir follows the repo's layout, detected from its main worktree:
  nested  repo/main, repo/feature-x        -> new dirs are bare branch slugs
  flat    repo, repo-feature-x (siblings)  -> new dirs carry the repo prefix
Force it with HERDR_WORKTREE_LAYOUT=nested|flat|auto (default auto).
EOF
}

branch=""
base=""
path=""
repo_arg=""
dry_run=0
interactive=0
fetch_first=1
context_ready=0

while (($#)); do
  case "$1" in
    --base)
      [[ $# -ge 2 ]] || { echo "missing value for --base" >&2; exit 2; }
      base="$2"
      shift 2
      ;;
    --path)
      [[ $# -ge 2 ]] || { echo "missing value for --path" >&2; exit 2; }
      path="$2"
      shift 2
      ;;
    --repo|--cwd)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      repo_arg="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --interactive)
      interactive=1
      shift
      ;;
    --no-fetch)
      fetch_first=0
      shift
      ;;
    --context-ready)
      context_ready=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      echo "unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      if [[ -n "$branch" ]]; then
        echo "unexpected argument: $1" >&2
        usage
        exit 2
      fi
      branch="$1"
      shift
      ;;
  esac
done

herdr="${HERDR_BIN_PATH:-herdr}"

finish() {
  local status="$1"
  if (( interactive )); then
    printf '\npress enter to close...' >&2
    IFS= read -r _
  fi
  exit "$status"
}

fail() {
  echo "$*" >&2
  finish 1
}

source_cwd() {
  if [[ -n "${HERDR_ENV:-}" ]] && command -v "$herdr" >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    local pane_json cwd
    if [[ -n "${HERDR_ACTIVE_PANE_ID:-}" ]]; then
      pane_json="$("$herdr" pane current --pane "$HERDR_ACTIVE_PANE_ID" 2>/dev/null || true)"
    else
      pane_json="$("$herdr" pane current --current 2>/dev/null || true)"
    fi
    cwd="$(printf '%s\n' "$pane_json" | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty' 2>/dev/null || true)"
    [[ -n "$cwd" ]] && { printf '%s\n' "$cwd"; return 0; }
  fi

  pwd
}

read_context_file() {
  local file="$1"
  [[ -f "$file" ]] || return 1

  local k v ctx="" cenv=""
  while IFS='=' read -r k v; do
    case "$k" in
      SHELL_CONTEXT) ctx="$v" ;;
      CONTEXT_ENV) cenv="$v" ;;
    esac
  done <"$file"

  [[ -n "$ctx" ]] || return 1
  printf '%s\t%s\n' "$ctx" "$cenv"
}

source_context() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-ctx"

  if [[ -n "${HERDR_ACTIVE_PANE_ID:-}" ]]; then
    read_context_file "$state_dir/$HERDR_ACTIVE_PANE_ID" && return 0
  fi

  if [[ -n "${HERDR_PANE_ID:-}" ]]; then
    read_context_file "$state_dir/$HERDR_PANE_ID" && return 0
  fi

  if [[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
    read_context_file "$state_dir/workspaces/$HERDR_ACTIVE_WORKSPACE_ID" && return 0
  fi

  if [[ -n "${HERDR_WORKSPACE_ID:-}" ]]; then
    read_context_file "$state_dir/workspaces/$HERDR_WORKSPACE_ID" && return 0
  fi

  [[ -n "${SHELL_CONTEXT:-}" ]] || return 1
  printf '%s\t%s\n' "$SHELL_CONTEXT" "${CONTEXT_ENV:-}"
}

shell_quote() {
  local value="$1"
  printf "'%s'" "${value//\'/\'\\\'\'}"
}

build_reexec_command() {
  local ctx="$1"
  local cenv="$2"
  local -a reargs

  reargs=(--context-ready)
  (( interactive )) && reargs+=(--interactive)
  (( dry_run )) && reargs+=(--dry-run)
  (( fetch_first )) || reargs+=(--no-fetch)
  [[ -n "$branch" ]] && reargs+=("$branch")
  [[ -n "$base" ]] && reargs+=(--base "$base")
  [[ -n "$path" ]] && reargs+=(--path "$path")
  [[ -n "$repo_arg" ]] && reargs+=(--repo "$repo_arg")

  printf 'cch %s >/dev/null' "$(shell_quote "$ctx")"
  if [[ -n "$cenv" ]]; then
    printf ' && cenv %s >/dev/null' "$(shell_quote "$cenv")"
  fi
  printf ' && exec %s' "$(shell_quote "$0")"
  local arg
  for arg in "${reargs[@]}"; do
    printf ' %s' "$(shell_quote "$arg")"
  done
}

reexec_with_context_if_needed() {
  (( context_ready )) && return 0

  local context_line ctx cenv cmd
  context_line="$(source_context || true)"
  [[ -n "$context_line" ]] || return 0

  IFS=$'\t' read -r ctx cenv <<<"$context_line"
  [[ -n "$ctx" ]] || return 0

  cmd="$(build_reexec_command "$ctx" "$cenv")"
  exec zsh -ic "$cmd"
}

activate_context_in_pane() {
  local pane_id="$1"
  local ctx="$2"
  local cenv="$3"
  local cmd

  [[ -n "$pane_id" && -n "$ctx" ]] || return 0

  cmd="cch --workspace $(shell_quote "$ctx")"
  if [[ -n "$cenv" ]]; then
    cmd="$cmd && cenv $(shell_quote "$cenv")"
  fi

  "$herdr" pane run "$pane_id" "$cmd" >/dev/null
}

slugify_ref() {
  local value="$1"
  value="${value#worktree/}"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  value="$(printf '%s' "$value" | sed -E 's#[^a-z0-9]+#-#g; s#^-+##; s#-+$##; s#-+#-#g')"
  [[ -n "$value" ]] && printf '%s\n' "$value" || printf 'worktree\n'
}

branch_exists() {
  git -C "$repo_root" show-ref --verify --quiet "refs/heads/$1"
}

remote_exists() {
  git -C "$repo_root" remote get-url "$1" >/dev/null 2>&1
}

default_remote() {
  if remote_exists origin; then
    printf 'origin\n'
    return 0
  fi

  git -C "$repo_root" remote | sed -n '1p'
}

remote_branch_ref() {
  local ref="$1"
  local remote="${ref%%/*}"

  if [[ "$ref" == */* ]] && remote_exists "$remote" &&
    git -C "$repo_root" show-ref --verify --quiet "refs/remotes/$ref"; then
    printf '%s\n' "$ref"
    return 0
  fi

  remote="$(default_remote)"
  [[ -n "$remote" ]] || return 1
  if git -C "$repo_root" show-ref --verify --quiet "refs/remotes/$remote/$ref"; then
    printf '%s/%s\n' "$remote" "$ref"
    return 0
  fi

  return 1
}

local_branch_for_remote_ref() {
  local ref="$1"
  printf '%s\n' "${ref#*/}"
}

generated_branch() {
  local -a adjectives nouns
  adjectives=(amber blue bright calm copper crimson deep fast golden green lunar misty quiet rapid red silver still swift violet wild)
  nouns=(brook canyon cedar comet dawn field harbor meadow moon ridge river spark stone tide valley wave)

  local candidate slug hex
  for _ in {1..40}; do
    printf -v hex '%04x' "$((RANDOM % 65536))"
    slug="${adjectives[$((RANDOM % ${#adjectives[@]}))]}-${nouns[$((RANDOM % ${#nouns[@]}))]}-$hex"
    candidate="worktree/$slug"
    branch_exists "$candidate" || { printf '%s\n' "$candidate"; return 0; }
  done

  echo "could not generate an unused branch name" >&2
  return 1
}

# The main worktree, not the current one. Paths must be derived from it, or
# creating a worktree from inside a worktree compounds the suffix
# (ivit-monorepo-feature-x-hotfix-y).
main_worktree_root() {
  local common_dir base

  if common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" &&
    [[ -n "$common_dir" ]]; then
    base="$(basename "$common_dir")"
    # .git dir -> its parent is the main checkout. A bare/.bare repo has no
    # checkout of its own, so the parent is the container.
    if [[ "$base" == ".git" || "$base" == ".bare" ]]; then
      dirname "$common_dir"
      return 0
    fi
  fi

  # Fallback: the first entry of `worktree list` is always the main worktree.
  git -C "$repo_root" worktree list --porcelain 2>/dev/null |
    sed -n 's/^worktree //p' | sed -n '1p'
}

# Both layouts keep worktrees as siblings of the main checkout and share one
# slug schema; only the directory prefix differs.
#
#   nested: <repo-name>/{main,feature-x,...}       -- dirs are bare branch slugs
#   flat:   <repo-name>{,-feature-x}               -- dirs carry the repo prefix
#
# Prints "<layout>\t<container>", where container is the dir new checkouts go
# into. Nested containers are named after the repo, so the prefix is redundant.
detect_layout() {
  local root="$1"
  local base head_branch parent

  # repo/.bare with checkouts alongside: root already *is* the container.
  if [[ -d "$root/.bare" ]]; then
    printf 'nested\t%s\n' "$root"
    return 0
  fi

  base="$(basename "$root")"
  parent="$(dirname "$root")"

  case "$base" in
    main|master|trunk|develop) printf 'nested\t%s\n' "$parent"; return 0 ;;
  esac

  # A checkout dir named after its own branch is the nested convention.
  head_branch="$(git -C "$root" symbolic-ref --short HEAD 2>/dev/null || true)"
  if [[ -n "$head_branch" && "$base" == "$(slugify_ref "$head_branch")" ]]; then
    printf 'nested\t%s\n' "$parent"
    return 0
  fi

  if [[ -d "$parent/.bare" ]]; then
    printf 'nested\t%s\n' "$parent"
    return 0
  fi

  printf 'flat\t%s\n' "$parent"
}

default_path_for_branch() {
  local ref="$1"
  local branch_slug
  branch_slug="$(slugify_ref "$ref")"

  if [[ "$layout" == "nested" ]]; then
    printf '%s/%s\n' "$container" "$branch_slug"
  else
    printf '%s/%s-%s\n' "$container" "$(basename "$main_root")" "$branch_slug"
  fi
}

label_for_path() {
  local target="$1"

  if [[ "$layout" == "nested" ]]; then
    printf '%s/%s\n' "$(basename "$container")" "$(basename "$target")"
  else
    basename "$target"
  fi
}

prompt_value() {
  local label="$1"
  local default="$2"
  local value
  printf '%s [%s]: ' "$label" "$default" >&2
  IFS= read -r value
  printf '%s\n' "${value:-$default}"
}

cwd="${repo_arg:-$(source_cwd)}"
repo_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || {
  fail "not inside a git repo: $cwd"
}

main_root="$(main_worktree_root)"
[[ -n "$main_root" ]] || main_root="$repo_root"

IFS=$'\t' read -r detected_layout container <<<"$(detect_layout "$main_root")"

case "${HERDR_WORKTREE_LAYOUT:-auto}" in
  auto) layout="$detected_layout" ;;
  nested|flat) layout="$HERDR_WORKTREE_LAYOUT" ;;
  *) fail "invalid HERDR_WORKTREE_LAYOUT: $HERDR_WORKTREE_LAYOUT (expected nested, flat, or auto)" ;;
esac

reexec_with_context_if_needed

if (( fetch_first && ! dry_run )); then
  (( interactive )) && printf 'fetching remotes...\n' >&2
  if ! git -C "$repo_root" fetch --all --prune; then
    fail "fetch failed; retry after fixing git credentials/network, or run: herdr-worktree --no-fetch"
  fi
fi

if [[ -z "$branch" ]]; then
  branch="$(generated_branch)" || fail "could not generate branch name"
fi

if (( interactive )); then
  printf 'repo: %s (%s layout)\n' "$main_root" "$layout" >&2
  [[ "$repo_root" == "$main_root" ]] || printf 'from: %s\n' "$repo_root" >&2
  printf '\n' >&2
  branch="$(prompt_value "branch" "$branch")"
fi

remote_ref=""
if [[ -z "$base" && -n "$branch" ]]; then
  remote_ref="$(remote_branch_ref "$branch" || true)"
  if [[ -n "$remote_ref" ]]; then
    branch="$(local_branch_for_remote_ref "$remote_ref")"
    base="$remote_ref"
  fi
fi

if (( interactive )); then
  base="$(prompt_value "base" "${base:-HEAD}")"
  [[ "$base" == "HEAD" ]] && base=""
fi

if branch_exists "$branch"; then
  fail "branch already exists: $branch"
fi

if [[ -z "$path" ]]; then
  path="$(default_path_for_branch "$branch")"
fi

if (( interactive )); then
  path="$(prompt_value "checkout" "$path")"
fi

if [[ -e "$path" ]]; then
  fail "worktree path already exists: $path"
fi

args=(worktree create --cwd "$repo_root" --branch "$branch" --path "$path" --label "$(label_for_path "$path")" --focus)
if [[ -n "$base" ]]; then
  args+=(--base "$base")
fi

if (( dry_run )); then
  printf 'repo:   %s\n' "$main_root"
  [[ "$repo_root" == "$main_root" ]] || printf 'from:   %s\n' "$repo_root"
  printf 'layout: %s\n' "$layout"
  printf 'branch: %s\n' "$branch"
  printf 'path:   %s\n' "$path"
  printf 'cmd:    %q' "$herdr"
  printf ' %q' "${args[@]}"
  printf '\n'
  exit 0
fi

context_line="$(source_context || true)"
ctx=""
cenv=""
if [[ -n "$context_line" ]]; then
  IFS=$'\t' read -r ctx cenv <<<"$context_line"
fi

if ! result="$("$herdr" "${args[@]}" --json)"; then
  fail "herdr worktree create failed"
fi
if (( interactive )); then
  printf 'created: %s\n' "$path"
else
  printf '%s\n' "$result"
fi

if [[ -n "$ctx" && -n "$(command -v jq)" ]]; then
  root_pane_id="$(printf '%s\n' "$result" | jq -r '.result.root_pane.pane_id // empty')"
  activate_context_in_pane "$root_pane_id" "$ctx" "$cenv"
  printf 'activated context: %s' "$ctx"
  [[ -n "$cenv" ]] && printf ':%s' "$cenv"
  printf '\n'
fi
