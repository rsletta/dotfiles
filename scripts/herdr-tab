#!/usr/bin/env bash
# herdr-tab
#
# Create a new herdr tab carrying the current workspace's default context.
# Bound via [[keys.command]] on prefix+c (see herdr/config.toml).
# Workspace state is written by cch/cenv in zshrc.d/71-contexts.sh.
#
# Degrades gracefully: with no workspace id or no recorded context it creates a
# plain tab with explicit empty context env, avoiding accidental inheritance
# from the herdr server process.
set -euo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"
pane="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
workspace="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"

if [[ -z "$workspace" && -n "$pane" ]]; then
  workspace="${pane%%:*}"
fi

args=(tab create)
if [[ -n "$workspace" ]]; then
  args+=(--workspace "$workspace")
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-ctx/workspaces"
ctx="" cenv=""
if [[ -n "$workspace" && -f "$state_dir/$workspace" ]]; then
  while IFS='=' read -r k v; do
    case "$k" in
      SHELL_CONTEXT) ctx="$v" ;;
      CONTEXT_ENV) cenv="$v" ;;
    esac
  done <"$state_dir/$workspace"
fi

args+=(--env "SHELL_CONTEXT=$ctx" --env "CONTEXT_ENV=$cenv")

exec "$herdr" "${args[@]}"
