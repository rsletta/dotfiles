#!/usr/bin/env bash
# herdr-worktree-rm
#
# Remove the current herdr-linked worktree workspace and checkout.
# Keeps the Git branch; this is a cleanup command for disposable review/agent
# worktrees.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: herdr-worktree-rm [--workspace ID] [--force] [--interactive] [--dry-run]

Removes a linked herdr worktree checkout and closes its workspace. Refuses to
remove source checkouts.

--interactive holds the pane open on failure; set it when running from a herdr
keybinding, where the pane would otherwise close before the error is readable.
EOF
}

workspace=""
force=0
dry_run=0
interactive=0

while (($#)); do
  case "$1" in
    --workspace)
      [[ $# -ge 2 ]] || { echo "missing value for --workspace" >&2; exit 2; }
      workspace="$2"
      shift 2
      ;;
    --force|-f)
      force=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --interactive)
      interactive=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      echo "unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      echo "unexpected argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

herdr="${HERDR_BIN_PATH:-herdr}"

finish() {
  local status="$1"
  if (( interactive )); then
    printf '\npress enter to close...' >&2
    IFS= read -r _
  fi
  exit "$status"
}

fail() {
  echo "$*" >&2
  finish 1
}

if [[ -z "$workspace" ]]; then
  if [[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
    workspace="$HERDR_ACTIVE_WORKSPACE_ID"
  elif [[ -n "${HERDR_WORKSPACE_ID:-}" ]]; then
    workspace="$HERDR_WORKSPACE_ID"
  elif [[ -n "${HERDR_ACTIVE_PANE_ID:-}" ]]; then
    workspace="${HERDR_ACTIVE_PANE_ID%%:*}"
  elif [[ -n "${HERDR_PANE_ID:-}" ]]; then
    workspace="${HERDR_PANE_ID%%:*}"
  elif command -v jq >/dev/null 2>&1; then
    workspace="$("$herdr" pane current --current 2>/dev/null | jq -r '.result.pane.workspace_id // empty')"
  fi
fi

[[ -n "$workspace" ]] || fail "could not determine current herdr workspace"

command -v jq >/dev/null 2>&1 || fail "jq is required"

# Explicit || fail: without it `set -e` kills the script here with no message of
# its own, which under a `type = "pane"` keybinding just flashes a closing pane.
# A stale herdr server (client/server protocol mismatch after an upgrade) makes
# every socket call fail this way.
workspaces_json="$("$herdr" workspace list)" ||
  fail "herdr workspace list failed — the herdr server may be stale after an upgrade.
Restart it:  HERDR_SOCKET_PATH=\"\${HERDR_SOCKET_PATH:-\$HOME/.config/herdr/herdr.sock}\" $herdr server stop
Then relaunch herdr. (Stopping exits pane processes.)"
checkout_path="$(printf '%s\n' "$workspaces_json" | jq -r --arg id "$workspace" '.result.workspaces[] | select(.workspace_id == $id) | .worktree.checkout_path // empty')"
is_linked="$(printf '%s\n' "$workspaces_json" | jq -r --arg id "$workspace" '.result.workspaces[] | select(.workspace_id == $id) | .worktree.is_linked_worktree // false')"
label="$(printf '%s\n' "$workspaces_json" | jq -r --arg id "$workspace" '.result.workspaces[] | select(.workspace_id == $id) | .label // $id')"

if [[ -z "$checkout_path" ]]; then
  fail "workspace is not a herdr worktree: $workspace"
fi

if [[ "$is_linked" != "true" ]]; then
  fail "refusing to remove source checkout: $checkout_path"
fi

printf 'workspace: %s (%s)\n' "$label" "$workspace"
printf 'checkout:  %s\n' "$checkout_path"
printf 'branch:    kept\n'

if (( dry_run )); then
  printf 'cmd:       %q worktree remove --workspace %q --force --json\n' "$herdr" "$workspace"
  exit 0
fi

if (( ! force )); then
  printf 'remove checkout and close workspace? [y/N] ' >&2
  IFS= read -r answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *)
      echo "cancelled" >&2
      exit 1
      ;;
  esac
fi

"$herdr" worktree remove --workspace "$workspace" --force --json >/dev/null ||
  fail "herdr worktree remove failed for workspace: $workspace"
printf 'removed:   %s\n' "$checkout_path"
