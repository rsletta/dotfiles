# Ghostty config
# Symlink to: ~/.config/ghostty/config.ghostty

# Shell
command = /bin/zsh

# Chrome
macos-non-native-fullscreen = visible-menu
window-padding-x = 8
window-padding-y = 6

# Minimal chrome: no titlebar, no borders, square corners, no traffic lights.
# Window movement handled by Rectangle. tmux handles windows/panes.
window-decoration = none

# Styles
font-family = CaskaydiaMono Nerd Font
theme = TokyoNight Night
font-size = 16
cursor-style = bar

# Keybindings
keybind = cmd+enter=toggle_fullscreen
keybind = opt+right=unbind
keybind = opt+left=unbind
keybind = opt+space=text:\x20
